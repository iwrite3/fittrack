# Builds the React frontend, then serves it with Caddy (which also does HTTPS + proxying).
FROM node:22-alpine AS build
WORKDIR /app
COPY fitness-app-frontend/package*.json ./
RUN npm ci
COPY fitness-app-frontend/ ./
ARG VITE_API_URL
ARG VITE_KEYCLOAK_URL
ARG VITE_REDIRECT_URI
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /app/dist /srv/frontend
COPY deploy/Caddyfile /etc/caddy/Caddyfile
