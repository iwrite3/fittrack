# Copy to .env on the server and fill in. NEVER commit .env.
DOMAIN=yourname.duckdns.org

POSTGRES_PASSWORD=change-me-long-random
RABBITMQ_USER=fitness
RABBITMQ_PASSWORD=change-me-long-random

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-long-random
# Use the same major version as your local Keycloak (check: docker ps on your PC)
KEYCLOAK_VERSION=26.0

DEEPSEEK_API_KEY=put-your-NEW-rotated-key-here
DEEPSEEK_MODEL=deepseek-flash
