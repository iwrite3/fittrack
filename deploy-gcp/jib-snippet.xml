<!-- OPTIONAL: add to each service pom.xml under <build><plugins>. Not required: deploy.ps1 calls Jib by CLI. -->
<plugin>
  <groupId>com.google.cloud.tools</groupId>
  <artifactId>jib-maven-plugin</artifactId>
  <version>3.4.5</version>
  <configuration>
    <from>
      <image>gcr.io/distroless/java21-debian12:nonroot</image>
      <platforms><platform><architecture>amd64</architecture><os>linux</os></platform></platforms>
    </from>
    <to>
      <image>${REGION}-docker.pkg.dev/${PROJECT_ID}/fittrack/${project.artifactId}:latest</image>
    </to>
    <container>
      <jvmFlags>
        <jvmFlag>-XX:TieredStopAtLevel=1</jvmFlag>
        <jvmFlag>-Xms64m</jvmFlag>
        <jvmFlag>-Xmx320m</jvmFlag>
        <jvmFlag>-XX:MaxMetaspaceSize=128m</jvmFlag>
        <jvmFlag>-XX:ReservedCodeCacheSize=48m</jvmFlag>
        <jvmFlag>-Xss512k</jvmFlag>
        <jvmFlag>-XX:+UseSerialGC</jvmFlag>
      </jvmFlags>
      <ports><port>8080</port></ports>
      <creationTime>USE_CURRENT_TIMESTAMP</creationTime>
    </container>
  </configuration>
</plugin>
